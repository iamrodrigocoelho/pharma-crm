# As variáveis do Awave CRM. Cole no EasyPanel, aba "Environment", e preencha.
# Onde achar cada valor: docs/DEPLOY.md, na seção 1.

# Connection string do Postgres. Use a conexão DIRETA (normalmente porta 5432) —
# pooler em modo transaction (convenção: 6543) quebra o lock das migrations e o
# inbox ao vivo. Em Postgres sem TLS (mesmo compose), acrescente ?sslmode=disable
DATABASE_URL=

# Assina os cookies de sessão e os links de arquivo. Mínimo 32 caracteres.
# Gere com: openssl rand -base64 48
# Trocar este valor desloga todo mundo.
PHARMA_SESSION_SECRET=

# Cifra o chaveiro (tokens de canal, chave de IA) em AES-256-GCM.
# 🔴 PERDER ESTE VALOR É PERDER OS SEGREDOS — não há recuperação, só recadastro.
# Se ficar vazio, cai em PHARMA_SESSION_SECRET; separar os dois é melhor, porque aí
# dá para rotacionar a sessão sem tocar no chaveiro.
PHARMA_SECRETS_KEY=

# ---------------------------------------------------------------------------
# Opcionais

# Onde ficam os arquivos enviados (anexos, logo, mídia de canal). Precisa ser um
# volume persistente. No container o padrão já é /app/dados/storage.
# PHARMA_STORAGE_DIR=

# URL pública do CRM. Deixa absolutos os links de arquivo e de webhook.
# PHARMA_URL_PUBLICA=https://crm.suaempresa.com

# Deploy em HTTP puro, sem TLS: libera o cookie de sessão (que é `secure` por padrão
# em produção). Só use em rede interna — em HTTP o cookie viaja em claro.
# PHARMA_SEM_TLS=1

# ---------------------------------------------------------------------------
# Compatibilidade
#
# Estas variáveis já se chamaram AWAVE_* (AWAVE_SESSION_SECRET, AWAVE_SECRETS_KEY,
# AWAVE_STORAGE_DIR, AWAVE_URL_PUBLICA, AWAVE_SEM_TLS, AWAVE_MODO,
# AWAVE_DIAGNOSTICO). Os nomes antigos CONTINUAM funcionando — um deploy que já
# esteja no ar não precisa de nada. O nome PHARMA_* tem precedência quando os dois
# estão definidos.
